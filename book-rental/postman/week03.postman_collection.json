{
  "info": {
    "name": "UMC 3주차 - 생 SQL 도서 대여 API",
    "description": "서버 실행 후 순서대로 Send. baseUrl = http://localhost:8080 (컬렉션 Variables 탭)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "실습 1. 도서 전체 조회",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "실습 2. 도서 등록",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"클린 코드\",\n  \"description\": \"애자일 소프트웨어 장인 정신\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "실습 2. 등록 후 다시 전체 조회",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "미션 1. 카테고리별 도서 조회",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books/category/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "category",
            "1"
          ]
        }
      }
    },
    {
      "name": "미션 2. 대여 기록 생성",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/rentals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rentals"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"bookId\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "선택 미션. 반납 처리",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/rentals/1/return",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rentals",
            "1",
            "return"
          ]
        }
      }
    },
    {
      "name": "선택 미션. 없는 대여 기록 반납 (404)",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/rentals/999/return",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rentals",
            "999",
            "return"
          ]
        }
      }
    }
  ]
}
