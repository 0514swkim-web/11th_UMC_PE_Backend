{
  "info": {
    "name": "UMC 7주차 - 로그인·토큰 인증 API",
    "description": "movie 서버 실행 후 위에서부터 순서대로 Send (또는 컬렉션 Run). 1·2번이 매번 새 회원 A·B를 만들고, 3·4번이 토큰 A·B를, 5번이 ratingId를 컬렉션 변수에 저장해 뒤 요청들이 사용.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "emailA",
      "value": ""
    },
    {
      "key": "emailB",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 회원 A 가입 (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{$timestamp}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"a{{$timestamp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 COMMON201\", () => { pm.response.to.have.status(201); pm.expect(pm.response.json().code).to.eql(\"COMMON201\"); });",
              "pm.collectionVariables.set(\"emailA\", pm.response.json().result.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. 회원 B 가입 (201)",
