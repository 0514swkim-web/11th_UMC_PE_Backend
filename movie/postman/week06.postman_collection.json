{
  "info": {
    "name": "UMC 6주차 - 회원가입·평점 저장 API",
    "description": "movie 서버 실행 후 위에서부터 순서대로 Send. 5번 평점 등록이 ratingId를 저장하고 8~13번이 사용. 13번은 11번에서 지운 평점을 다시 지우므로 404.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 회원가입 성공 (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user{{$timestamp}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"u{{$timestamp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. 회원가입 이메일 형식 오류 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"wrong-email\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"newbie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. 회원가입 비밀번호 규칙 오류 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"new@example.com\",\n  \"password\": \"1234\",\n  \"nickname\": \"newbie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. 회원가입 이메일 중복 (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"noco@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"newbie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. 평점 등록 (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 680,\n  \"score\": 5,\n  \"comment\": \"펄프 픽션 최고\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 등록된 평점 ID를 컬렉션 변수에 저장 → 아래 수정·삭제 요청이 {{ratingId}}로 사용",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"ratingId\", pm.response.json().result);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. 같은 영화 평점 중복 (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 680,\n  \"score\": 4,\n  \"comment\": \"한 번 더\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. 별점 범위 밖 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 13,\n  \"score\": 6,\n  \"comment\": \"6점 주고 싶음\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. 평점 수정 (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings",
            "{{ratingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 3,\n  \"comment\": \"다시 보니 보통\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. 수정 결과 조회 (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings"
          ]
        }
      }
    },
    {
      "name": "10. 다른 회원이 수정 (403)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/2/ratings/{{ratingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "2",
            "ratings",
            "{{ratingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1,\n  \"comment\": \"남의 평점 수정 시도\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. 평점 삭제 (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings",
            "{{ratingId}}"
          ]
        }
      }
    },
    {
      "name": "12. 삭제 후 조회 (목록에서 사라짐)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings"
          ]
        }
      }
    },
    {
      "name": "13. 없는 평점 삭제 (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "ratings",
            "{{ratingId}}"
          ]
        }
      }
    }
  ]
}
