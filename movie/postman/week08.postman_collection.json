{
  "info": {
    "name": "UMC 8주차 - 즐겨찾기·영화 기록 API",
    "description": "1→16 순서대로 Run. 1번이 매번 새 회원을 만들어서 반복 실행해도 같은 결과.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 테스트 회원 가입 (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"w8{{$timestamp}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"w8{{$timestamp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 COMMON201\", () => { pm.response.to.have.status(201); pm.expect(pm.response.json().code).to.eql(\"COMMON201\"); });",
              "pm.collectionVariables.set(\"email\", pm.response.json().result.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. 로그인 → 토큰 저장 (200)",
